{
  "name": "dsh-helm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-node control plane for DSH (DeepSeek Harness) ChatGPT Helm connectors",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -b packages/*/tsconfig.json",
    "typecheck": "tsc -b packages/*/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "clean": "rm -rf packages/*/lib",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"packages/*/tests/**/*.ts\" \"tests/**/*.ts\"",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.0"
  }
}
